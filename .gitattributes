# Keep large dataset payloads out of Git history; Git LFS stores the actual objects.
# LFS must be enabled and quota/billing verified before uploading these paths.
datasets/**/*.zip filter=lfs diff=lfs merge=lfs -text
datasets/**/*.7z filter=lfs diff=lfs merge=lfs -text
datasets/**/*.tar filter=lfs diff=lfs merge=lfs -text
datasets/**/*.gz filter=lfs diff=lfs merge=lfs -text
datasets/**/*.parquet filter=lfs diff=lfs merge=lfs -text
datasets/**/*.arrow filter=lfs diff=lfs merge=lfs -text
datasets/**/*.sqlite3 filter=lfs diff=lfs merge=lfs -text
datasets/**/*.db filter=lfs diff=lfs merge=lfs -text
datasets/**/*.bin filter=lfs diff=lfs merge=lfs -text
datasets/**/*.safetensors filter=lfs diff=lfs merge=lfs -text
datasets/**/*.pt filter=lfs diff=lfs merge=lfs -text
datasets/**/*.onnx filter=lfs diff=lfs merge=lfs -text
datasets/**/*.wav filter=lfs diff=lfs merge=lfs -text
datasets/**/*.flac filter=lfs diff=lfs merge=lfs -text
datasets/**/*.mp3 filter=lfs diff=lfs merge=lfs -text
datasets/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
